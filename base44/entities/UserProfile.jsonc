{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "default_role": {
      "type": "string",
      "enum": [
        "administrator",
        "vertretung",
        "buero",
        "finance"
      ]
    },
    "preferred_organizations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_workspaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "executive",
          "operations",
          "finance",
          "projects",
          "documents",
          "goals",
          "knowledge"
        ]
      },
      "description": "Sichtbare Workspaces fuer diesen Benutzer. Steuert die Navigationssicht."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notification_preferences": {
      "type": "string"
    }
  },
  "required": [
    "user"
  ]
}
