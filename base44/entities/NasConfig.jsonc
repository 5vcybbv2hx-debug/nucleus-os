{
  "name": "NasConfig",
  "type": "object",
  "properties": {
    "nasUrl": {
      "type": "string"
    },
    "nasUsername": {
      "type": "string"
    },
    "nasPassword": {
      "type": "string"
    },
    "basePath": {
      "type": "string"
    },
    "lastSync": {
      "type": "string",
      "format": "date-time"
    },
    "connectionStatus": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "disconnected"
    },
    "connectionMessage": {
      "type": "string"
    },
    "syncInterval": {
      "type": "string",
      "enum": [
        "5",
        "15",
        "30",
        "60",
        "180"
      ],
      "default": "60",
      "description": "Sync-Intervall in Minuten"
    },
    "syncEnabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nasUrl",
    "nasUsername"
  ]
}