{
  "name": "CaseTimeline",
  "description": "Chronologische Aktivitäten pro Vorgang",
  "type": "object",
  "properties": {
    "case_id": {"type": "string"},
    "entry_type": {"type": "string", "enum": ["business_event", "task", "decision", "note", "comment", "status_change", "document", "calendar", "idea"]},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "source_entity_id": {"type": "string"},
    "source_entity_type": {"type": "string"},
    "source_system": {"type": "string"},
    "metadata": {"type": "object"}
  },
  "required": ["case_id", "entry_type", "title"]
}
