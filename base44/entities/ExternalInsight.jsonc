{
  "schema": {
    "properties": {
      "title": { "type": "string", "description": "Insight-Titel" },
      "summary": { "type": "string", "description": "Zusammenfassung" },
      "type": { "type": "string", "enum": ["event", "staffing", "task", "reservation", "warning"], "description": "Insight-Typ" },
      "severity": { "type": "string", "enum": ["critical", "high", "medium", "warning", "info"], "description": "Schweregrad" },
      "organization": { "type": "string", "description": "Zugehörige Organisation" },
      "source_system": { "type": "string", "description": "Quellsystem (z.B. SAVO)" },
      "external_reference": { "type": "string", "description": "Externe Referenz-ID für Upsert" },
      "effective_date": { "type": "string", "format": "date", "description": "Gültig ab" },
      "valid_until": { "type": "string", "format": "date", "description": "Gültig bis" },
      "status": { "type": "string", "enum": ["active", "expired", "archived"], "description": "Insight-Status" },
      "last_synced_at": { "type": "string", "format": "date-time", "description": "Letzte Synchronisation" }
    },
    "type": "object"
  },
  "entity_name": "ExternalInsight",
  "description": "Externe Insights aus verbundenen Apps (z.B. SAVO Bar-App)"
}
