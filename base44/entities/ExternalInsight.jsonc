{
  "name": "ExternalInsight",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "insight_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "warning",
        "info"
      ]
    },
    "organization": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "archived"
      ]
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "external_reference": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "source_app": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}