{
  "name": "IntegrationConnection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "source_app": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "target_app": {
      "type": "string"
    },
    "connection_mode": {
      "type": "string",
      "enum": [
        "read_only",
        "mock",
        "stale",
        "disabled"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "error"
      ]
    },
    "organization": {
      "type": "string"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_success_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "data_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "configuration": {
      "type": "object"
    }
  }
}