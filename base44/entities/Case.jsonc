{
  "name": "Case",
  "description": "Zentrale zusammengehörige Angelegenheit — Herzstück von Atlas",
  "type": "object",
  "properties": {
    "title": {"type": "string"},
    "description": {"type": "string"},
    "case_type_key": {"type": "string"},
    "organization": {"type": "string"},
    "status": {"type": "string", "enum": ["Entwurf", "Aktiv", "Wartet", "Blockiert", "Abgeschlossen", "Archiviert"], "default": "Entwurf"},
    "priority": {"type": "string", "enum": ["hoch", "mittel", "niedrig"], "default": "mittel"},
    "owner": {"type": "string"},
    "visibility": {"type": "string", "enum": ["Team", "Beteiligte", "Nur Pierre", "Privat", "Vertraulich"], "default": "Team"},
    "business_value": {"type": "string"},
    "risk_level": {"type": "string", "enum": ["niedrig", "mittel", "hoch"], "default": "niedrig"},
    "parent_case": {"type": "string"},
    "is_archived": {"type": "boolean", "default": false},
    "archived_at": {"type": "string", "format": "date-time"}
  },
  "required": ["title", "case_type_key", "organization"]
}
