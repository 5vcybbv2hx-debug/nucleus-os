{
  "name": "IntegrationEvent",
  "type": "object",
  "properties": {
    "connection": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "external_entity_id": {
      "type": "string"
    },
    "external_entity_type": {
      "type": "string"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "error"
      ]
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "related_atlas_entity": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    }
  }
}