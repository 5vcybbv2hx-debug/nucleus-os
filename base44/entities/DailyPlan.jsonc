{
  "name": "DailyPlan",
  "type": "object",
  "properties": {
    "user": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "day_mode": {
      "type": "string",
      "enum": [
        "Viel Energie",
        "Normal",
        "M\u00fcde",
        "Chaotischer Tag",
        "Handwerkstag",
        "Barbetrieb",
        "Familie",
        "Urlaub",
        "Nur Dringendes"
      ],
      "default": "Normal",
      "description": "LEGACY FIELD — Mix aus Tagesart und Arbeitsweise. Neue Logik verwendet work_mode und day_type. Nicht f\u00fcr neue Datens\u00e4tze verwenden."
    },
    "work_mode": {
      "type": "string",
      "enum": [
        "Fokus",
        "Verwaltung",
        "Kreativ",
        "Handwerklich",
        "Unterwegs",
        "Besprechung",
        "Review"
      ],
      "default": "Verwaltung",
      "description": "Aktuelle Arbeitsweise des Benutzers. Orthogonal zum Workspace."
    },
    "day_type": {
      "type": "string",
      "enum": [
        "Arbeitstag",
        "Urlaub",
        "Feiertag",
        "Krank",
        "Familie",
        "Sonderfall"
      ],
      "default": "Arbeitstag",
      "description": "Art des Tages. Ersetzt die Tagesart-Werte aus day_mode."
    },
    "energy_level": {
      "type": "string",
      "enum": [
        "niedrig",
        "mittel",
        "hoch"
      ]
    },
    "available_time": {
      "type": "number"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "manually_adjusted": {
      "type": "boolean",
      "default": false
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user",
    "date"
  ]
}
